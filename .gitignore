# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ──
.venv/
venv/
env/

# ── PyInstaller build output ──
/build/
/dist/
*.manifest

# ── Bundled FFmpeg binaries (downloaded per-platform, not versioned) ──
assets/bin/*
!assets/bin/.gitkeep

# ── ML model weights (downloaded on first use, not versioned) ──
models/*
!models/.gitkeep

# ── User config / logs ──
*.log
config.toml

# ── Editors / OS ──
.idea/
.vscode/
.DS_Store
Thumbs.db
