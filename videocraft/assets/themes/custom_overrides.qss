/* VideoCraft — Custom QSS overrides on top of qt-material.
 *
 * Colors are tokens (at-prefixed) substituted at apply time from the theme's
 * palette (see core/theme.py), so text always contrasts its background in
 * both dark and light themes. Do NOT hardcode background/text hexes here —
 * add a token instead. The one exception is the Log Panel, which is a
 * terminal-style console and stays dark on purpose.
 */

/* ── Log Panel (intentionally a dark console in every theme) ── */
QPlainTextEdit#logPanel {
    font-family: "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    font-size: 11pt;
    background-color: #111111;
    color: #d4d4d4;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px;
}

/* ── Queue Table ── */
QTableWidget {
    gridline-color: @border;
    border: 1px solid @border;
    border-radius: 4px;
    selection-background-color: @bglight;
    selection-color: @text;
}

QTableWidget::item {
    padding: 4px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: @bglight;
    color: @text;
}

QHeaderView::section {
    background-color: @bglight;
    color: @text;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid @accent;
    font-weight: 600;
}

/* ── Progress Bar ── */
QProgressBar {
    border: 1px solid @border;
    border-radius: 3px;
    text-align: center;
    height: 14px;
    background-color: @bgdark;
    color: @text;
}

QProgressBar::chunk {
    background-color: @accent;
    border-radius: 3px;
}

/* ── Tab Bar ── */
QTabBar::tab {
    background-color: @bglight;
    color: @textdim;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: @bg;
    color: @accent;
    font-weight: 600;
    border-bottom: 2px solid @accent;
}

QTabBar::tab:hover:!selected {
    background-color: @bglight;
    color: @text;
}

/* ── Buttons ── */
QPushButton {
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px 16px;
    background-color: @bglight;
    color: @text;
    min-height: 24px;
}

QPushButton:hover {
    background-color: @bglight;
    border-color: @accent;
    color: @accent;
}

QPushButton:pressed {
    background-color: @accent;
    color: #ffffff;
}

QPushButton:disabled {
    color: @textdim;
    border-color: @border;
    background-color: @bgdark;
}

/* ── Primary action buttons (Start, Save, etc.) ── */
QPushButton#btn_start,
QPushButton#btn_save,
QPushButton#btn_proceed {
    background-color: @accent;
    color: #ffffff;
    border-color: @accent;
    font-weight: 600;
}

QPushButton#btn_start:hover,
QPushButton#btn_save:hover,
QPushButton#btn_proceed:hover {
    background-color: @accentlight;
    border-color: @accentlight;
    color: #ffffff;
}

/* ── Combo Boxes ── */
QComboBox {
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: @bgdark;
    color: @text;
    min-height: 24px;
}

QComboBox:hover {
    border-color: @accent;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @textdim;
}

QComboBox QAbstractItemView {
    background-color: @bgdark;
    color: @text;
    selection-background-color: @bglight;
    border: 1px solid @border;
}

/* ── Sliders ── */
QSlider::groove:horizontal {
    height: 4px;
    background: @border;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    background: @accent;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: @accentlight;
}

QSlider::sub-page:horizontal {
    background: @accent;
    border-radius: 2px;
}

/* ── Spin Boxes ── */
QSpinBox, QDoubleSpinBox {
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: @bgdark;
    color: @text;
    min-height: 24px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: @accent;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: @bglight;
    border: none;
    width: 20px;
}

/* ── Line Edits ── */
QLineEdit {
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: @bgdark;
    color: @text;
    min-height: 24px;
}

QLineEdit:hover {
    border-color: @accent;
}

QLineEdit:focus {
    border-color: @accent;
    border-width: 2px;
}

/* ── Group Boxes ── */
QGroupBox {
    font-weight: 600;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: @accent;
}

/* ── Labels ── */
QLabel {
    color: @text;
}

/* Secondary / hint labels — dimmer but still legible in both themes. */
QLabel[hint="true"] {
    color: @textdim;
}

/* Success / confirmation text (e.g. drop confirmation). */
QLabel[state="success"] {
    color: @success;
}

/* ── Checkboxes ── */
QCheckBox {
    color: @text;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid @border;
    border-radius: 3px;
    background-color: @bgdark;
}

QCheckBox::indicator:checked {
    background-color: @accent;
    border-color: @accent;
}

QCheckBox::indicator:hover {
    border-color: @accent;
}

/* ── Radio Buttons ── */
QRadioButton {
    color: @text;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid @border;
    border-radius: 9px;
    background-color: @bgdark;
}

QRadioButton::indicator:checked {
    background-color: @accent;
    border-color: @accent;
}

/* ── Scroll Bars ── */
QScrollBar:vertical {
    width: 10px;
    background: @bgdark;
    border: none;
}

QScrollBar::handle:vertical {
    background: @border;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: @accent;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    height: 10px;
    background: @bgdark;
    border: none;
}

QScrollBar::handle:horizontal {
    background: @border;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: @accent;
}

/* ── Menu Bar ── */
QMenuBar {
    background-color: @bglight;
    color: @text;
    border-bottom: 1px solid @border;
}

QMenuBar::item:selected {
    background-color: @bglight;
}

QMenu {
    background-color: @bgdark;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 32px 6px 16px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: @bglight;
    color: @accent;
}

QMenu::separator {
    height: 1px;
    background: @border;
    margin: 4px 8px;
}

/* ── Dialogs ── */
QDialog {
    background-color: @bg;
}

/* ── Splitter ── */
QSplitter::handle {
    background-color: @border;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: @accent;
}
